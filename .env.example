# TradeGenius AI Strategy Builder - Environment Configuration

# Database (Prisma + libSQL/SQLite by default)
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-in-production"

# OAuth providers (optional - app works without auth for demo)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_ID=""
GITHUB_SECRET=""

# AI configuration (any OpenAI-compatible endpoint)
OPENAI_API_KEY=""
OPENAI_BASE_URL=""
OPENAI_MODEL=""

# Rate limiting (optional - falls back to in-memory limiter)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
